<launch>
    <include file="$(find-pkg-share microstrain_inertial_driver)/launch/microstrain_launch.py">
        <arg name="params_file" value="$(env RBROOT)/src/buggy/INS_params.yml"/>
    </include>
    <arg name="config_file" default="src/buggy/config/sc-roll.yaml"/>
    <arg name="use_lidar" default="false"/>

    <node pkg="foxglove_bridge" exec="foxglove_bridge" name="foxglove" output = "screen" namespace="SC"/>

    <node name="bnyahaj" pkg="buggy" exec="ros_to_bnyahaj.py" respawn="true" output="screen" namespace="SC">
        <param from="$(var config_file)"/>
    </node>
    <node name="stateconverter" pkg = "buggy" exec = "buggy_state_converter.py" output="screen" namespace="SC"/>
    <node name="localization_monitor" pkg="buggy" exec="localization_monitor.py" namespace="SC" output="screen">
        <param from="$(var config_file)"/>
    </node>
    <!-- use_lidar:=true when buggy_lidar.py (lidar branch) publishes /lidar/obstacle_centroid -->
    <node name="lidar_opponent" pkg="buggy" exec="lidar_opponent_node.py" namespace="SC" output="screen" if="$(var use_lidar)">
        <param from="$(var config_file)"/>
    </node>
    <!-- <node pkg="buggy" exec="detector_node.py" name="detector" output="screen" namespace="SC"/> -->

    <!-- <include file="$(find-pkg-share velodyne)/launch/velodyne-all-nodes-VLP16-launch.py">
        <arg name="frame_id" value="velodyne"/>
        <arg name="port" value="2368"/>
        <arg name="rpm" value="300.0"/>
        <arg name="cut_angle" value="6.28"/>
        <arg name="model" value="VLP16"/>
    </include> -->

</launch>