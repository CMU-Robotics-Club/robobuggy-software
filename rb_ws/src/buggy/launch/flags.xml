<!-- TODO - this file will eventually be autogenerated from flags yaml in project root 
once fflag system is fully implemented

using combined arg+set-parameter lets us conditionally launch node from launchfile itself
if we need to
-->
<launch>
    <arg name="ff_use_steer_offset_estimate" default="false"/>
    <set_parameter name="ff_use_steer_offset_estimate" value="$(var ff_use_steer_offset_estimate)"/>

    <arg name="ff_enable_v1_control_stack" default="false"/>
    <set_parameter name="ff_enable_v1_control_stack" value="$(var ff_enable_v1_control_stack)"/>

    <arg name="ff_vision_detector" default="false"/>
    <set_parameter name="ff_vision_detector" value="$(var ff_vision_detector)"/>

    <arg name="ff_vision_lidar" default="false"/>
    <set_parameter name="ff_vision_lidar" value="$(var ff_vision_lidar)"/>
</launch>