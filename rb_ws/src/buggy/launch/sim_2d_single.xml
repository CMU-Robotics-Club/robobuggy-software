<!--
  sim_2d_single.xml : one simulated buggy (SC) on the course.

  use_frenet:=false (default)  the controller follows the static reference JSON (legacy).
  use_frenet:=true             the experimental Frenet planner publishes planning/result
                               envelopes and the controller runs in envelope mode: it steers
                               only on control-eligible, unexpired plans and falls back to the
                               static reference otherwise (DECISIONS.md D1). Nothing here
                               reaches hardware; this is the simulator.
  use_speed_model:=true        gravity speed model instead of a constant velocity.

  The localization monitor runs with the SIMULATION policy (no GNSS fix or INS filter status
  exists in the sim, so those requirements are switched off explicitly). The hardware launch
  uses the hardware policy from config/sc-roll.yaml.
-->
<launch>
    <!-- one BLAS thread per node: the 100 Hz numpy loops otherwise leave OpenBLAS workers spin-waiting
         (each controller showed ~200 % CPU on a 24-core laptop, 2026-09-15) -->
    <set_env name="OPENBLAS_NUM_THREADS" value="1"/>
    <set_env name="OMP_NUM_THREADS" value="1"/>

    <arg name="config_file" default="src/buggy/config/sim_single_sc.yaml"/>
    <arg name="use_speed_model" default="false"/>
    <!-- line:=buggycourse_sc_raceline.json runs SC on the optimiser output instead of the team line;
         NAND always keeps its own line. course_viz draws the team line alongside for comparison. -->
    <arg name="line" default="buggycourse_sc.json"/>
    <arg name="use_viz" default="true"/>
    <arg name="use_frenet" default="false"/>

    <node pkg="foxglove_bridge" exec="foxglove_bridge" name="foxglove" namespace="SC"/>

    <node pkg="buggy" exec="engine.py" name="SC_sim_single" namespace="SC">
        <param from="$(var config_file)"/>
    </node>
    <!-- To enable the ros2b node for measuring control latency, run this command in an ssh'd terminal:
    $ sudo socat -d -d PTY,raw,echo=0,link=/dev/ttyVirtual0,user=nand,mode=777 GOPEN:/dev/null,ignoreeof
    -->
    <!-- <node pkg="buggy" exec="ros_to_bnyahaj.py" name="SC_ros_to_bnyahaj" respawn="true" namespace="SC">
        <param from="$(var config_file)"/>
    </node> -->
    <node pkg="buggy" exec="buggy_state_converter.py" name="SC_state_converter" namespace="SC"/>

    <!-- legacy: static reference trajectory -->
    <node pkg="buggy" exec="controller_node.py" name="SC_controller" namespace="SC" unless="$(var use_frenet)">
        <param from="$(var config_file)"/>
        <param name="traj_name" value="$(var line)"/>
    </node>
    <!-- experimental: envelope mode -->
    <node pkg="buggy" exec="controller_node.py" name="SC_controller" namespace="SC" output="screen" if="$(var use_frenet)">
        <param from="$(var config_file)"/>
        <param name="traj_name" value="$(var line)"/>
        <param name="planningResultTopic" value="planning/result"/>
    </node>
    <node pkg="buggy" exec="frenet_planner.py" name="SC_path_planner" namespace="SC" output="screen" if="$(var use_frenet)">
        <param from="$(var config_file)"/>
        <param name="traj_name" value="$(var line)"/>
    </node>

    <node pkg="buggy" exec="steer_offset_estimator.py" name="SC_offset_estimator" namespace="SC">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="localization_monitor.py" name="SC_localization_monitor" namespace="SC" output="screen">
        <param from="$(var config_file)"/>
        <param name="require_rtk_for_ok" value="false"/>
        <param name="require_filter_for_ok" value="false"/>
    </node>
    <!-- use_speed_model:=true replaces the constant sim velocity with the gravity speed model (config/course_zones.yaml) -->
    <node pkg="buggy" exec="speed_model_node.py" name="SC_speed_model" namespace="SC" output="screen" if="$(var use_speed_model)">
        <param from="$(var config_file)"/>
        <param name="traj_name" value="$(var line)"/>
    </node>

    <!-- use_viz:=true (default) publishes Foxglove markers: course, plan, tracks, truth, HUD (foxglove/racing_sim_layout.json) -->
    <node pkg="buggy" exec="course_viz.py" name="SC_course_viz" namespace="SC" output="screen" if="$(var use_viz)">
        <param from="$(var config_file)"/>
        <param name="traj_name" value="$(var line)"/>
    </node>

</launch>
