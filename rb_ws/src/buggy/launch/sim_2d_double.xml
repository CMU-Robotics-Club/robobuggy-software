<launch>

    <arg name="config_file" default="src/buggy/config/sim_double.yaml"/>
    <arg name="use_frenet" default="true"/>
    <arg name="use_speed_model" default="false"/>
    <arg name="use_perception_sim" default="false"/>

    <node pkg="foxglove_bridge" exec="foxglove_bridge" name="foxglove" output = "screen" namespace="SC"/>

    <node pkg="buggy" exec="buggy_state_converter.py" name="NAND_state_converter" output = "screen" namespace="NAND"/>
    <node pkg="buggy" exec="controller_node.py" name="NAND_controller" output = "screen" namespace="NAND">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="steer_offset_estimator.py" name="NAND_offset_estimator" namespace="NAND"/>

    <node pkg="buggy" exec="engine.py" name="NAND_sim_single" output = "screen" namespace="NAND">
        <param from="$(var config_file)"/>
    </node>
    
    <node pkg="buggy" exec="buggy_state_converter.py" name="SC_state_converter" output = "screen" namespace="SC"/>
    <node pkg="buggy" exec="controller_node.py" name="SC_controller" output = "screen" namespace="SC">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="steer_offset_estimator.py" name="SC_offset_estimator" namespace="SC"/>

    <node pkg="buggy" exec="engine.py" name="SC_sim_single" output = "screen" namespace="SC">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="radio_sim.py" name="SC_radio" output = "screen" namespace="SC">
        <param from="$(var config_file)"/>
    </node>

    <!-- use_frenet:=true (default) runs the Frenet sampling planner; use_frenet:=false runs the legacy sigmoid planner -->
    <node pkg="buggy" exec="frenet_planner.py" name="SC_path_planner" namespace="SC" output = "screen" if="$(var use_frenet)">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="path_planner.py" name="SC_path_planner" namespace="SC" output = "screen" unless="$(var use_frenet)">
        <param from="$(var config_file)"/>
    </node>

    <node pkg="buggy" exec="controller_node.py" name="SC_NAND_controller" output = "screen" namespace="SC">
        <param from="$(var config_file)"/>
    </node>

    <node name="estimator" pkg="buggy" exec="nand_estimator.py" output="screen" namespace="SC"/>
    <!-- use_perception_sim:=true adds fake lidar + camera detections of NAND so the fused estimator runs in sim -->
    <node pkg="buggy" exec="perception_sim.py" name="SC_lidar_sim" namespace="SC" output="screen" if="$(var use_perception_sim)">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="perception_sim.py" name="SC_camera_sim" namespace="SC" output="screen" if="$(var use_perception_sim)">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="opponent_tracker.py" name="SC_opponent_tracker" namespace="SC" output="screen" if="$(var use_perception_sim)">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="localization_monitor.py" name="SC_localization_monitor" namespace="SC" output="screen"/>
    <!-- use_speed_model:=true replaces the constant sim velocity with the gravity speed model (config/course_zones.yaml) -->
    <node pkg="buggy" exec="speed_model_node.py" name="SC_speed_model" namespace="SC" output="screen" if="$(var use_speed_model)">
        <param from="$(var config_file)"/>
    </node>

</launch>