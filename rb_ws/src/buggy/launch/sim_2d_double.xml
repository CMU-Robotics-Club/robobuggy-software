<!--
  sim_2d_double.xml : SC and NAND on the course, NAND relayed to SC by the simulated radio.

  use_frenet:=true (default)     the experimental Frenet planner publishes planning/result and
                                 SC's controller runs in envelope mode (steers only on
                                 control-eligible, unexpired plans; falls back to the static
                                 reference otherwise). DECISIONS.md D1.
  use_frenet:=false              the legacy sigmoid planner drives through self/cur_traj.
  use_perception_sim:=true       fake lidar + camera detections of NAND and any ghost buggies
                                 (config: SC_lidar_sim / SC_camera_sim), so the tracker sees
                                 several opponents.
  use_speed_model:=true          gravity speed model instead of a constant velocity.
  use_lidar_sim:=true            a ray-cast VLP-16 (lidar_sim.py) publishes /velodyne_points from a 3D
                                 world built from the course files; the REAL clustering node
                                 (buggy_lidar.py) and adapter (lidar_opponent_node.py) turn it into
                                 lidar/detection_array. Pair it with use_fake_lidar:=false so
                                 perception_sim's shortcut lidar detections do not double up:
                                     ros2 launch buggy sim_2d_double.xml use_perception_sim:=true use_lidar_sim:=true use_fake_lidar:=false

  The opponent tracker (the single fusion authority, D5) always runs. Its inputs are the
  structured detection arrays and, in the simulator, NAND's RAW relayed position on
  other/stateNoUKF (never the UKF output). The NAND UKF (nand_estimator.py) still runs for
  the NAND shadow controller; the planner does not read it.

  The localization monitor runs with the SIMULATION policy (no GNSS fix / INS status in sim).
-->
<launch>
    <!-- one BLAS thread per node: the 100 Hz numpy loops otherwise leave OpenBLAS workers spin-waiting
         (each controller showed ~200 % CPU on a 24-core laptop, 2026-09-15) -->
    <set_env name="OPENBLAS_NUM_THREADS" value="1"/>
    <set_env name="OMP_NUM_THREADS" value="1"/>

    <arg name="config_file" default="src/buggy/config/sim_double.yaml"/>
    <arg name="use_viz" default="true"/>
    <arg name="use_frenet" default="true"/>
    <arg name="use_speed_model" default="false"/>
    <arg name="use_perception_sim" default="false"/>
    <arg name="use_lidar_sim" default="false"/>
    <arg name="use_fake_lidar" default="$(var use_perception_sim)"/>

    <node pkg="foxglove_bridge" exec="foxglove_bridge" name="foxglove" output = "screen" namespace="SC"/>

    <node pkg="buggy" exec="buggy_state_converter.py" name="NAND_state_converter" output = "screen" namespace="NAND"/>
    <node pkg="buggy" exec="controller_node.py" name="NAND_controller" output = "screen" namespace="NAND">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="steer_offset_estimator.py" name="NAND_offset_estimator" namespace="NAND"/>

    <node pkg="buggy" exec="engine.py" name="NAND_sim_single" output = "screen" namespace="NAND">
        <param from="$(var config_file)"/>
    </node>

    <node pkg="buggy" exec="buggy_state_converter.py" name="SC_state_converter" output = "screen" namespace="SC"/>
    <!-- legacy controller: follows self/cur_traj from the sigmoid planner -->
    <node pkg="buggy" exec="controller_node.py" name="SC_controller" output = "screen" namespace="SC" unless="$(var use_frenet)">
        <param from="$(var config_file)"/>
    </node>
    <!-- experimental controller: envelope mode -->
    <node pkg="buggy" exec="controller_node.py" name="SC_controller" output = "screen" namespace="SC" if="$(var use_frenet)">
        <param from="$(var config_file)"/>
        <param name="planningResultTopic" value="planning/result"/>
    </node>
    <node pkg="buggy" exec="steer_offset_estimator.py" name="SC_offset_estimator" namespace="SC"/>

    <node pkg="buggy" exec="engine.py" name="SC_sim_single" output = "screen" namespace="SC">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="radio_sim.py" name="SC_radio" output = "screen" namespace="SC">
        <param from="$(var config_file)"/>
    </node>

    <node pkg="buggy" exec="frenet_planner.py" name="SC_path_planner" namespace="SC" output = "screen" if="$(var use_frenet)">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="path_planner.py" name="SC_path_planner" namespace="SC" output = "screen" unless="$(var use_frenet)">
        <param from="$(var config_file)"/>
    </node>

    <node pkg="buggy" exec="controller_node.py" name="SC_NAND_controller" output = "screen" namespace="SC">
        <param from="$(var config_file)"/>
    </node>

    <node name="estimator" pkg="buggy" exec="nand_estimator.py" output="screen" namespace="SC"/>
    <!-- use_perception_sim:=true adds fake lidar + camera detections of NAND and the ghosts -->
    <node pkg="buggy" exec="perception_sim.py" name="SC_lidar_sim" namespace="SC" output="screen" if="$(var use_fake_lidar)">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="perception_sim.py" name="SC_camera_sim" namespace="SC" output="screen" if="$(var use_perception_sim)">
        <param from="$(var config_file)"/>
    </node>
    <!-- use_lidar_sim:=true: simulated VLP-16 -> real clustering -> real UTM adapter -> tracker -->
    <node pkg="buggy" exec="lidar_sim.py" name="SC_lidar_sim_cloud" namespace="SC" output="screen" if="$(var use_lidar_sim)">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="buggy_lidar.py" name="buggy_lidar" namespace="SC" output="screen" if="$(var use_lidar_sim)">
        <param name="input_topic" value="/velodyne_points"/>
        <param name="input_file" value=""/>
        <param name="frames_to_merge" value="1"/>
        <param name="circle_radius" value="30.0"/>
        <param name="ellipse_half_width" value="6.0"/>
        <param name="ellipse_half_depth" value="30.0"/>
        <param name="ellipse_forward_offset" value="10.0"/>
        <param name="dbscan_eps" value="0.5"/>
        <param name="dbscan_min_points" value="8"/>
    </node>
    <node pkg="buggy" exec="lidar_opponent_node.py" name="lidar_opponent" namespace="SC" output="screen" if="$(var use_lidar_sim)">
        <param from="$(var config_file)"/>
        <param name="extrinsics_status" value="simulated:lidar_sim.py"/>
    </node>

    <!-- the single fusion authority; always on -->
    <node pkg="buggy" exec="opponent_tracker.py" name="SC_opponent_tracker" namespace="SC" output="screen">
        <param from="$(var config_file)"/>
    </node>
    <node pkg="buggy" exec="localization_monitor.py" name="SC_localization_monitor" namespace="SC" output="screen">
        <param from="$(var config_file)"/>
        <param name="require_rtk_for_ok" value="false"/>
        <param name="require_filter_for_ok" value="false"/>
    </node>
    <!-- use_speed_model:=true replaces the constant sim velocity with the gravity speed model (config/course_zones.yaml) -->
    <node pkg="buggy" exec="speed_model_node.py" name="SC_speed_model" namespace="SC" output="screen" if="$(var use_speed_model)">
        <param from="$(var config_file)"/>
    </node>

    <!-- use_viz:=true (default) publishes Foxglove markers: course, plan, tracks, truth, HUD (foxglove/racing_sim_layout.json) -->
    <node pkg="buggy" exec="course_viz.py" name="SC_course_viz" namespace="SC" output="screen" if="$(var use_viz)">
        <param from="$(var config_file)"/>
    </node>

</launch>
